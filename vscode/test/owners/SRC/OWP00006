 OWP00006: PROC(IOPCB_PTR, DBPCB_PTR) OPTIONS(MAIN);
   DCL (IOPCB_PTR, DBPCB_PTR) POINTER;
   DCL 1 DBPCB BASED(DBPCB_PTR), 2 DBDNAME CHAR(8);
   DCL PLITDLI ENTRY EXTERNAL OPTIONS(ASM INTER);
   DCL DREI FIXED BIN(31) STATIC INIT(3);
   DCL ISRT_FUNC CHAR(4) STATIC INIT('ISRT');
   DCL SEGNAME CHAR(8);
   DCL SSA CHAR(9);
   DCL SEG CHAR(60);
   SSA = SEGNAME;
   CALL PLITDLI(DREI, ISRT_FUNC, DBPCB, SEG, SSA);
 END OWP00006;
