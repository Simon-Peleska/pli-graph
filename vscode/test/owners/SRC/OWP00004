 OWP00004: PROC(DBPCB_PTR) OPTIONS(MAIN);
   DCL DBPCB_PTR POINTER;
   DCL 1 DBPCB BASED(DBPCB_PTR), 2 DBDNAME CHAR(8);
   DCL PLITDLI ENTRY EXTERNAL OPTIONS(ASM INTER);
   DCL DREI FIXED BIN(31) STATIC INIT(3);
   DCL ISRT_FUNC CHAR(4) STATIC INIT('ISRT');
   DCL KONTO_SSA CHAR(9) STATIC INIT('KONTO    ');
   DCL KONTO_SEG CHAR(60);
   CALL PLITDLI(DREI, ISRT_FUNC, DBPCB, KONTO_SEG, KONTO_SSA);
 END OWP00004;
